package nixflux

import (
	"archive/tar"
	"archive/zip"
	"bytes"
	"compress/bzip2"
	"compress/gzip"
	"crypto/sha256"
	"encoding/hex"
	"errors"
	"fmt"
	"io"
	"os"
	"os/exec"
	"path"
	"path/filepath"
	"sort"
	"strconv"
	"strings"
)

const (
	maxDebControlSize = int64(8 << 20)
	maxDebPayloadSize = int64(2 << 30)
)

type debArMember struct {
	name string
	data []byte
}

type debPayloadFile struct {
	data  []byte
	mode  osFileMode
	isDir bool
}

// osFileMode is kept as a uint32 here so the parser does not depend on host
// permission semantics when building a store archive.
type osFileMode uint32

// debToZip reads the Debian ar container and its control/data tar archives
// directly. dpkg-deb is deliberately not a runtime dependency.
func debToZip(raw []byte) ([]byte, error) {
	members, err := readDebAr(raw)
	if err != nil {
		return nil, err
	}
	var controlArchive, dataArchive []byte
	var controlName, dataName string
	binaryVersionFound := false
	controlFound := false
	dataFound := false
	for _, member := range members {
		switch {
		case member.name == "debian-binary":
			if binaryVersionFound {
				return nil, fmt.Errorf("Debian archive contains duplicate debian-binary members")
			}
			binaryVersionFound = true
			if strings.TrimSpace(string(member.data)) != "2.0" {
				return nil, fmt.Errorf("unsupported Debian binary package version %q", strings.TrimSpace(string(member.data)))
			}
		case strings.HasPrefix(member.name, "control.tar"):
			if controlFound {
				return nil, fmt.Errorf("Debian archive contains duplicate control.tar members")
			}
			controlFound = true
			controlArchive, controlName = member.data, member.name
		case strings.HasPrefix(member.name, "data.tar"):
			if dataFound {
				return nil, fmt.Errorf("Debian archive contains duplicate data.tar members")
			}
			dataFound = true
			dataArchive, dataName = member.data, member.name
		}
	}
	if !binaryVersionFound || !controlFound || !dataFound || len(controlArchive) == 0 || len(dataArchive) == 0 {
		return nil, fmt.Errorf("Debian archive must contain one debian-binary, one control.tar and one data.tar member")
	}

	controlRaw, err := decompressDebTar(controlArchive, controlName, maxDebControlSize)
	if err != nil {
		return nil, fmt.Errorf("cannot decompress %s: %w", controlName, err)
	}
	control, err := readDebControlTar(controlRaw)
	if err != nil {
		return nil, err
	}
	fields, err := parseControlFieldsStrict(string(control))
	if err != nil {
		return nil, fmt.Errorf("invalid Debian control file: %w", err)
	}
	name, version, arch := fields["package"], fields["version"], fields["architecture"]
	if !isValidPackageName(name) || !parseDebianVersion(version).valid {
		return nil, fmt.Errorf(".deb contains an invalid Package or Debian Version field: %q %q", name, version)
	}
	if !debArchitectureMatches(arch) {
		return nil, fmt.Errorf(".deb architecture %q is incompatible with %s/%s (expected %s or all)", arch, runtimeGOOS, runtimeGOARCH, runtimeDebianArchitecture())
	}
	deps, err := parseDebDependencies(fields["pre-depends"], fields["depends"])
	if err != nil {
		return nil, err
	}
	// The ar member slices reference the original .deb buffer. Drop all
	// references except dataArchive before expanding the payload.
	members = nil
	controlArchive = nil
	controlRaw = nil
	control = nil
	raw = nil
	payloadRaw, err := decompressDebTar(dataArchive, dataName, maxDebPayloadSize)
	dataArchive = nil
	if err != nil {
		return nil, fmt.Errorf("cannot decompress %s: %w", dataName, err)
	}
	files, err := readDebDataTar(payloadRaw)
	payloadRaw = nil
	if err != nil {
		return nil, err
	}
	if len(files) == 0 {
		return nil, fmt.Errorf(".deb contains no supported payload files")
	}

	paths := make([]string, 0, len(files))
	for name := range files {
		paths = append(paths, name)
	}
	sort.Strings(paths)
	entrypoints := []string{}
	for _, name := range paths {
		if strings.HasPrefix(name, "payload/bin/") && !files[name].isDir {
			entrypoints = append(entrypoints, name)
		}
	}
	platform := "linux"
	if runtimeGOOS == "android" {
		platform = "android"
	}
	goArch := goArchitectureForDebian(arch)
	manifest := fmt.Sprintf("[package]\nname = %q\nversion = %q\nplatform = %q\narchitecture = %q\ndependencies = %s\nentrypoints = %s\n", name, version, platform, goArch, tomlArray(deps), tomlArray(entrypoints))
	checksums := strings.Builder{}
	for _, name := range paths {
		if files[name].isDir {
			continue
		}
		sum := sha256.Sum256(files[name].data)
		fmt.Fprintf(&checksums, "%s  %s\n", hex.EncodeToString(sum[:]), name)
	}
	var output bytes.Buffer
	zw := zip.NewWriter(&output)
	write := func(name string, content []byte, mode uint32) error {
		header := &zip.FileHeader{Name: name, Method: zip.Deflate}
		header.SetMode(fileModeForZip(mode))
		w, err := zw.CreateHeader(header)
		if err != nil {
			return err
		}
		_, err = w.Write(content)
		return err
	}
	if err := write("package.toml", []byte(manifest), 0o644); err != nil {
		return nil, err
	}
	if err := write("checksums.sha256", []byte(checksums.String()), 0o644); err != nil {
		return nil, err
	}
	for _, name := range paths {
		mode := uint32(files[name].mode)
		if files[name].isDir {
			header := &zip.FileHeader{Name: strings.TrimSuffix(name, "/") + "/", Method: zip.Store}
			header.SetMode(os.ModeDir | os.FileMode(mode))
			if _, err := zw.CreateHeader(header); err != nil {
				return nil, err
			}
			continue
		}
		if strings.HasPrefix(name, "payload/bin/") && mode&0o111 == 0 {
			mode |= 0o111
		}
		if err := write(name, files[name].data, mode); err != nil {
			return nil, err
		}
	}
	if err := zw.Close(); err != nil {
		return nil, err
	}
	return output.Bytes(), nil
}

func readDebAr(raw []byte) ([]debArMember, error) {
	if len(raw) < 8 || string(raw[:8]) != "!<arch>\n" {
		return nil, fmt.Errorf("invalid Debian ar archive signature")
	}
	members := []debArMember{}
	var stringTable []byte
	for offset := 8; offset < len(raw); {
		if len(members) >= 4096 {
			return nil, fmt.Errorf("ar archive contains too many members")
		}
		if len(raw)-offset < 60 {
			return nil, fmt.Errorf("truncated ar member header")
		}
		header := raw[offset : offset+60]
		if string(header[58:60]) != "`\n" {
			return nil, fmt.Errorf("invalid ar member trailer")
		}
		nameField := strings.TrimSpace(string(header[:16]))
		if nameField == "" {
			return nil, fmt.Errorf("ar member has an empty name")
		}
		for _, field := range []struct {
			name string
			text string
			base int
		}{{"mtime", string(header[16:28]), 10}, {"uid", string(header[28:34]), 10}, {"gid", string(header[34:40]), 10}, {"mode", string(header[40:48]), 8}} {
			value := strings.TrimSpace(field.text)
			if value == "" {
				continue
			}
			if _, parseErr := strconv.ParseUint(value, field.base, 64); parseErr != nil {
				return nil, fmt.Errorf("invalid ar member %s field %q", field.name, value)
			}
		}
		sizeText := strings.TrimSpace(string(header[48:58]))
		size, err := strconv.ParseInt(sizeText, 10, 64)
		if err != nil || size < 0 {
			return nil, fmt.Errorf("invalid ar member size %q", sizeText)
		}
		start := offset + 60
		end := int64(start) + size
		if end < int64(start) || end > int64(len(raw)) {
			return nil, fmt.Errorf("ar member exceeds archive bounds")
		}
		content := raw[start:int(end)]
		switch {
		case nameField == "//":
			stringTable = append([]byte(nil), content...)
		case nameField == "/" || nameField == "__.SYMDEF" || nameField == "__.SYMDEF SORTED":
			// Symbol tables are not package payload.
		case strings.HasPrefix(nameField, "#1/"):
			nameLength, e := strconv.Atoi(strings.TrimPrefix(nameField, "#1/"))
			if e != nil || nameLength < 0 || nameLength > len(content) {
				return nil, fmt.Errorf("invalid BSD ar extended filename")
			}
			members = append(members, debArMember{name: string(content[:nameLength]), data: content[nameLength:]})
		case strings.HasPrefix(nameField, "/") && len(nameField) > 1:
			offsetValue, e := strconv.Atoi(strings.TrimPrefix(nameField, "/"))
			if e != nil || offsetValue < 0 || offsetValue >= len(stringTable) {
				return nil, fmt.Errorf("invalid GNU ar filename reference")
			}
			endName := bytes.IndexByte(stringTable[offsetValue:], '\n')
			if endName < 0 {
				return nil, fmt.Errorf("unterminated GNU ar filename")
			}
			name := strings.TrimSuffix(strings.TrimSuffix(string(stringTable[offsetValue:offsetValue+endName]), "/"), "\r")
			members = append(members, debArMember{name: name, data: content})
		default:
			name := strings.TrimSuffix(nameField, "/")
			members = append(members, debArMember{name: name, data: content})
		}
		offset = int(end)
		if offset%2 != 0 {
			if offset >= len(raw) || raw[offset] != '\n' {
				return nil, fmt.Errorf("missing or invalid ar member alignment padding")
			}
			offset++
		}
	}
	return members, nil
}

func decompressDebTar(raw []byte, memberName string, limit int64) ([]byte, error) {
	var reader io.Reader
	switch {
	case strings.HasSuffix(memberName, ".tar"):
		if int64(len(raw)) > limit {
			return nil, fmt.Errorf("uncompressed tar exceeds size limit")
		}
		return raw, nil
	case strings.HasSuffix(memberName, ".tar.gz") || strings.HasSuffix(memberName, ".tgz"):
		gz, err := gzip.NewReader(bytes.NewReader(raw))
		if err != nil {
			return nil, err
		}
		defer gz.Close()
		reader = gz
	case strings.HasSuffix(memberName, ".tar.bz2"):
		reader = bzip2.NewReader(bytes.NewReader(raw))
	case strings.HasSuffix(memberName, ".tar.xz") || strings.HasSuffix(memberName, ".tar.lzma"):
		return runXZDecompress(raw, limit)
	default:
		return nil, fmt.Errorf("unsupported Debian tar compression: %s", memberName)
	}
	result, err := io.ReadAll(io.LimitReader(reader, limit+1))
	if err != nil {
		return nil, err
	}
	if int64(len(result)) > limit {
		return nil, fmt.Errorf("decompressed tar exceeds size limit")
	}
	return result, nil
}

var errDecompressedOutputLimit = errors.New("decompressed output exceeds size limit")

type limitedOutput struct {
	buffer bytes.Buffer
	limit  int64
}

func (w *limitedOutput) Write(data []byte) (int, error) {
	if int64(w.buffer.Len())+int64(len(data)) > w.limit {
		return 0, errDecompressedOutputLimit
	}
	return w.buffer.Write(data)
}

func runXZDecompress(raw []byte, limit int64) ([]byte, error) {
	if limit <= 0 {
		return nil, fmt.Errorf("invalid decompressed output limit")
	}
	tool, err := exec.LookPath("xz")
	if err != nil {
		return nil, fmt.Errorf("xz is required to read xz-compressed Debian archives")
	}
	cmd := exec.Command(tool, "-dc", "--")
	cmd.Stdin = bytes.NewReader(raw)
	output := &limitedOutput{limit: limit}
	var stderr limitedOutput
	stderr.limit = 64 << 10
	cmd.Stdout = output
	cmd.Stderr = &stderr
	if err := cmd.Run(); err != nil {
		if errors.Is(err, errDecompressedOutputLimit) {
			return nil, errDecompressedOutputLimit
		}
		if stderr.buffer.Len() > 0 {
			return nil, fmt.Errorf("xz decompression failed: %w: %s", err, strings.TrimSpace(stderr.buffer.String()))
		}
		return nil, fmt.Errorf("xz decompression failed: %w", err)
	}
	return output.buffer.Bytes(), nil
}

func readDebControlTar(raw []byte) ([]byte, error) {
	tr := tar.NewReader(bytes.NewReader(raw))
	var control []byte
	for {
		header, err := tr.Next()
		if err == io.EOF {
			break
		}
		if err != nil {
			return nil, fmt.Errorf("invalid control.tar archive: %w", err)
		}
		name, normalizeErr := normalizeDebPayloadPath(header.Name)
		if normalizeErr != nil {
			return nil, fmt.Errorf("invalid control.tar path: %w", normalizeErr)
		}
		baseName := path.Base(name)
		switch baseName {
		case "preinst", "postinst", "prerm", "postrm", "config", "triggers":
			return nil, fmt.Errorf("Debian package uses unsupported maintainer metadata %q", baseName)
		case "control":
			if control != nil {
				return nil, fmt.Errorf("control.tar contains duplicate control files")
			}
			if header.Typeflag != tar.TypeReg && header.Typeflag != tar.TypeRegA {
				return nil, fmt.Errorf("Debian control member is not a regular file")
			}
			content, err := io.ReadAll(io.LimitReader(tr, maxDebControlSize+1))
			if err != nil {
				return nil, err
			}
			if int64(len(content)) > maxDebControlSize {
				return nil, fmt.Errorf("Debian control file exceeds size limit")
			}
			control = content
		}
	}
	if control == nil {
		return nil, fmt.Errorf("control.tar does not contain a control file")
	}
	return control, nil
}

func readDebDataTar(raw []byte) (map[string]debPayloadFile, error) {
	tr := tar.NewReader(bytes.NewReader(raw))
	files := map[string]debPayloadFile{}
	links := []struct {
		name, target string
		mode         uint32
	}{}
	for {
		header, err := tr.Next()
		if err == io.EOF {
			break
		}
		if err != nil {
			return nil, fmt.Errorf("invalid data.tar archive: %w", err)
		}
		name, err := normalizeDebPayloadPath(header.Name)
		if err != nil {
			return nil, err
		}
		if name == "" {
			continue
		}
		stored, err := mapDebPayloadPath(name)
		if err != nil {
			return nil, err
		}
		mode := uint32(header.Mode) & 0o777
		if mode == 0 {
			mode = 0o644
		}
		switch header.Typeflag {
		case tar.TypeDir:
			if _, exists := files[stored]; exists {
				return nil, fmt.Errorf("duplicate normalized payload path %q", stored)
			}
			files[stored] = debPayloadFile{mode: osFileMode(mode), isDir: true}
		case tar.TypeReg, tar.TypeRegA:
			if header.Size < 0 || header.Size > maxDebPayloadSize {
				return nil, fmt.Errorf("invalid data.tar member size for %q", name)
			}
			content, err := io.ReadAll(io.LimitReader(tr, maxDebPayloadSize+1))
			if err != nil {
				return nil, err
			}
			if int64(len(content)) > maxDebPayloadSize || int64(len(content)) != header.Size {
				return nil, fmt.Errorf("invalid data.tar member contents for %q", name)
			}
			if _, exists := files[stored]; exists {
				return nil, fmt.Errorf("duplicate normalized payload path %q", stored)
			}
			files[stored] = debPayloadFile{data: content, mode: osFileMode(mode)}
		case tar.TypeSymlink:
			target, targetErr := normalizeDebSymlinkTarget(stored, name, header.Linkname)
			if targetErr != nil || !safeSymlinkTarget(stored, target) {
				return nil, fmt.Errorf("unsafe Debian symlink %q -> %q", stored, header.Linkname)
			}
			if _, exists := files[stored]; exists {
				return nil, fmt.Errorf("duplicate normalized payload path %q", stored)
			}
			files[stored] = debPayloadFile{data: []byte(target), mode: osFileMode(0o120000)}
		case tar.TypeLink:
			target, targetErr := normalizeDebPayloadPath(header.Linkname)
			if targetErr != nil {
				return nil, targetErr
			}
			mappedTarget, targetErr := mapDebPayloadPath(target)
			if targetErr != nil {
				return nil, targetErr
			}
			links = append(links, struct {
				name, target string
				mode         uint32
			}{stored, mappedTarget, mode})
		default:
			return nil, fmt.Errorf("unsupported special Debian payload entry %q (type %d)", name, header.Typeflag)
		}
	}
	for _, link := range links {
		target, ok := files[link.target]
		if !ok || target.isDir || target.mode&0o170000 == 0o120000 {
			return nil, fmt.Errorf("Debian hardlink target %q is missing or is not a regular file", link.target)
		}
		if _, exists := files[link.name]; exists {
			return nil, fmt.Errorf("duplicate normalized payload path %q", link.name)
		}
		files[link.name] = debPayloadFile{data: target.data, mode: osFileMode(link.mode)}
	}
	return files, nil
}

func normalizeDebPayloadPath(raw string) (string, error) {
	if raw == "" || strings.Contains(raw, "\\") || strings.HasPrefix(raw, "/") {
		return "", fmt.Errorf("unsafe absolute or empty Debian payload path %q", raw)
	}
	value := raw
	for strings.HasPrefix(value, "./") {
		value = strings.TrimPrefix(value, "./")
	}
	clean := path.Clean(value)
	if clean == "." || clean == "" {
		return "", nil
	}
	if clean == ".." || strings.HasPrefix(clean, "../") || strings.HasPrefix(clean, "/") {
		return "", fmt.Errorf("Debian payload path escapes package root: %q", raw)
	}
	return clean, nil
}

func mapDebPayloadPath(raw string) (string, error) {
	const termuxPrefix = "data/data/com.termux/files/usr/"
	termuxPath := strings.HasPrefix(raw, termuxPrefix)
	value := raw
	if termuxPath {
		value = strings.TrimPrefix(value, termuxPrefix)
	}
	if strings.HasPrefix(value, "usr/") {
		value = strings.TrimPrefix(value, "usr/")
	}
	if value == "" || value == "." || value == ".." || strings.HasPrefix(value, "../") {
		return "", fmt.Errorf("invalid Debian payload path %q", raw)
	}
	parts := strings.Split(value, "/")
	switch parts[0] {
	case "bin", "sbin", "games":
		remaining := strings.TrimPrefix(value, parts[0])
		remaining = strings.TrimPrefix(remaining, "/")
		if remaining == "" {
			return "", fmt.Errorf("invalid Debian binary payload path %q", raw)
		}
		return "payload/bin/" + remaining, nil
	}
	if termuxPath {
		return "payload/usr/" + path.Clean(value), nil
	}
	if strings.HasPrefix(raw, "usr/") {
		return "payload/usr/" + path.Clean(value), nil
	}
	return "payload/" + path.Clean(value), nil
}

func normalizeDebSymlinkTarget(storedName, originalName, rawTarget string) (string, error) {
	var mappedTarget string
	if strings.HasPrefix(rawTarget, "/") {
		allowed := strings.HasPrefix(rawTarget, "/data/data/com.termux/files/usr/") ||
			strings.HasPrefix(rawTarget, "/usr/") || strings.HasPrefix(rawTarget, "/bin/") ||
			strings.HasPrefix(rawTarget, "/sbin/") || strings.HasPrefix(rawTarget, "/etc/") ||
			strings.HasPrefix(rawTarget, "/lib/") || strings.HasPrefix(rawTarget, "/lib64/")
		if !allowed {
			return "", fmt.Errorf("absolute symlink target is outside a supported package prefix")
		}
		target, err := mapDebPayloadPath(strings.TrimPrefix(rawTarget, "/"))
		if err != nil {
			return "", err
		}
		mappedTarget = target
	} else {
		if strings.Contains(rawTarget, "\\") || rawTarget == "" {
			return "", fmt.Errorf("invalid symlink target")
		}
		resolved := path.Clean(path.Join(path.Dir(originalName), rawTarget))
		normalized, err := normalizeDebPayloadPath(resolved)
		if err != nil {
			return "", fmt.Errorf("relative symlink target escapes package root")
		}
		mappedTarget, err = mapDebPayloadPath(normalized)
		if err != nil {
			return "", err
		}
	}
	relative, err := filepath.Rel(filepath.FromSlash(path.Dir(storedName)), filepath.FromSlash(mappedTarget))
	if err != nil {
		return "", err
	}
	return filepath.ToSlash(relative), nil
}

func fileModeForZip(mode uint32) os.FileMode {
	if mode&0o170000 == 0o120000 {
		return os.ModeSymlink | 0o777
	}
	return os.FileMode(mode & 0o777)
}

func debArchitectureMatches(arch string) bool {
	if arch == "all" {
		return true
	}
	return arch == runtimeDebianArchitecture()
}

func goArchitectureForDebian(arch string) string {
	if arch == "all" {
		return "all"
	}
	switch arch {
	case "aarch64", "arm64":
		return "arm64"
	case "arm", "armhf", "armel":
		return "arm"
	case "i686", "i386":
		return "386"
	case "x86_64", "amd64":
		return "amd64"
	default:
		return arch
	}
}

func parseDebDependencies(fields ...string) ([]string, error) {
	result := []string{}
	for _, raw := range fields {
		if strings.TrimSpace(raw) == "" {
			continue
		}
		for _, group := range strings.Split(raw, ",") {
			alternatives := []string{}
			for _, rawAlternative := range strings.Split(group, "|") {
				alternative := strings.TrimSpace(rawAlternative)
				filtered, applies, err := filterDebianArchitectureRestriction(alternative, runtimeDebianArchitecture(), runtimeGOOS)
				if err != nil {
					return nil, err
				}
				if !applies {
					continue
				}
				name, constraint, err := parseDebDependencyAlternative(filtered)
				if err != nil {
					return nil, err
				}
				alternatives = append(alternatives, name+constraint)
			}
			if len(alternatives) > 0 {
				result = append(result, strings.Join(alternatives, " | "))
			}
		}
	}
	return result, nil
}

func filterDebianArchitectureRestriction(raw, architecture, operatingSystem string) (string, bool, error) {
	open := strings.IndexByte(raw, '[')
	if open < 0 {
		if strings.Contains(raw, " <") {
			return "", false, fmt.Errorf("Debian build-profile restrictions are not supported in binary Depends: %q", raw)
		}
		return strings.TrimSpace(raw), true, nil
	}
	close := strings.IndexByte(raw[open+1:], ']')
	if close < 0 || strings.Contains(raw[open+1+close+1:], "[") || strings.Contains(raw[:open], "]") {
		return "", false, fmt.Errorf("invalid Debian architecture restriction %q", raw)
	}
	close += open + 1
	if strings.TrimSpace(raw[close+1:]) != "" {
		return "", false, fmt.Errorf("unexpected data after Debian architecture restriction %q", raw)
	}
	conditions := strings.Fields(raw[open+1 : close])
	if len(conditions) == 0 {
		return "", false, fmt.Errorf("empty Debian architecture restriction")
	}
	positiveMatch := false
	hasPositive := false
	negativeMatch := false
	for _, condition := range conditions {
		negative := strings.HasPrefix(condition, "!")
		pattern := strings.TrimPrefix(condition, "!")
		if pattern == "" {
			return "", false, fmt.Errorf("invalid Debian architecture restriction %q", condition)
		}
		matched := matchDebianArchitecturePattern(pattern, architecture, operatingSystem)
		if negative {
			negativeMatch = negativeMatch || matched
		} else {
			hasPositive = true
			positiveMatch = positiveMatch || matched
		}
	}
	applies := !negativeMatch && (!hasPositive || positiveMatch)
	return strings.TrimSpace(raw[:open]), applies, nil
}

func matchDebianArchitecturePattern(pattern, architecture, operatingSystem string) bool {
	if pattern == "any" {
		return true
	}
	if pattern == "linux-any" {
		return operatingSystem == "linux"
	}
	if strings.HasPrefix(pattern, "any-") {
		return strings.Contains(architecture, strings.TrimPrefix(pattern, "any-"))
	}
	if strings.HasSuffix(pattern, "-any") {
		return strings.HasPrefix(architecture, strings.TrimSuffix(pattern, "-any"))
	}
	return strings.EqualFold(pattern, architecture)
}

func parseDebDependencyAlternative(raw string) (string, string, error) {
	if raw == "" {
		return "", "", fmt.Errorf("empty Debian dependency alternative")
	}
	if strings.Contains(raw, " <") {
		return "", "", fmt.Errorf("Debian build-profile restrictions are not supported in binary Depends: %q", raw)
	}
	name := raw
	constraint := ""
	if open := strings.Index(raw, " ("); open >= 0 {
		name = strings.TrimSpace(raw[:open])
		rest := strings.TrimSpace(raw[open+2:])
		close := strings.IndexByte(rest, ')')
		if close < 0 || strings.TrimSpace(rest[close+1:]) != "" {
			return "", "", fmt.Errorf("invalid Debian dependency constraint %q", raw)
		}
		parts := strings.Fields(strings.TrimSpace(rest[:close]))
		if len(parts) != 2 {
			return "", "", fmt.Errorf("invalid Debian dependency constraint %q", raw)
		}
		op := map[string]string{"=": "==", ">=": ">=", "<=": "<=", ">>": ">", "<<": "<"}[parts[0]]
		if op == "" || !parseDebianVersion(parts[1]).valid {
			return "", "", fmt.Errorf("unsupported Debian dependency constraint %q", raw)
		}
		constraint = op + parts[1]
	} else if strings.ContainsAny(raw, "()") {
		return "", "", fmt.Errorf("invalid Debian dependency %q", raw)
	}
	name = strings.TrimSpace(strings.Split(name, ":")[0])
	if !isValidPackageName(name) {
		return "", "", fmt.Errorf("invalid Debian dependency package name %q", name)
	}
	return name, constraint, nil
}

func tomlArray(values []string) string {
	parts := make([]string, len(values))
	for i, value := range values {
		parts[i] = strconv.Quote(value)
	}
	return "[" + strings.Join(parts, ", ") + "]"
}
